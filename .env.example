# Postgres connection string (Neon, Supabase, Railway, Render or your own)
DATABASE_URL=postgres://user:password@host:5432/formflow
# Public URL of this app, used for share links and webhook payloads
APP_URL=https://formflow.example.com
# Fastn embed (Settings -> API keys in Fastn, with "Verify caller identity" on)
FASTN_API_KEY=fsk_live_...
FASTN_IDENTITY_SECRET=fivs_...
# FASTN_API_URL=https://api.fastn.dev
# Formflow's own connector in Fastn (ids from GET /api/v1/connectors?search=formflow)
FASTN_PRODUCT_CONNECTOR_ID=
FASTN_PRODUCT_AUTH_METHOD_ID=
